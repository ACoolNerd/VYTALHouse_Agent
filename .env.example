VYTAL_ENVIRONMENT=development
VYTAL_DATABASE_URL=sqlite:///./data/vytalhouse.db
VYTAL_ADMIN_TOKEN=local-admin-token-change-me
VYTAL_RATE_LIMIT_REQUESTS=60
VYTAL_RATE_LIMIT_WINDOW_SECONDS=60
VYTAL_EMBEDDED_WORKER=true
VYTAL_WORKER_POLL_SECONDS=0.2
VYTAL_MAX_TASK_RETRIES=2
VYTAL_LOG_LEVEL=INFO
VYTAL_KNOWLEDGE_DIR=knowledge/seed
